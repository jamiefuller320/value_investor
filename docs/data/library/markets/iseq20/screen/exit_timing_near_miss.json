      ],
      "default_min_conviction": 0.28,
      "default_max_episodes_per_week": 25,
      "aligned_with": "trajectory_evidence.PRE_BUY_CONVICTION"
    },
    "note": "Observe-only priors from archived weekly screens plus rebalance_log held-ticker episodes. Does not replace live paper exit_timing cohorts."
