        "replacement_outperformed",
        "exit_outperformed",
        "inconclusive"
      ],
      "fields_for_later_analysis": [
        "sell_tickers",
        "buy_tickers",
        "sell_realized_pct",
        "post_rotation_returns",
        "trade_costs"
      ]
